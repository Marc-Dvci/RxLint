# Nebius Token Factory (https://tokenfactory.nebius.com)
NEBIUS_API_KEY=
# Model ids (defaults shown). Each role can also take its own base URL and key: RXLINT_OMNI_BASE_URL, RXLINT_ULTRA_API_KEY, ...
RXLINT_OMNI_MODEL=nvidia/Nemotron-3-Nano-Omni-30B-A3B-Reasoning
RXLINT_ULTRA_MODEL=nvidia/Nemotron-3-Ultra-550b-a55b
RXLINT_FAST_MODEL=nvidia/NVIDIA-Nemotron-3-Nano-30B-A3B
# live | record | replay | auto (auto replays a recorded response when one exists, otherwise calls the model)
RXLINT_MODEL_MODE=auto
# Tavily (https://tavily.com) for the live regulator plane
TAVILY_API_KEY=
